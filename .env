# Database Configuration
# Source Database (SQL Server) - Ajustar según el servidor fuente real
SQL_SERVER_CONNECTION_STRING=mssql+pyodbc://sa:yourStrong(!)Password@localhost/SourceDB?driver=ODBC+Driver+17+for+SQL+Server

# Destination Database (PostgreSQL) - External DB Server
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@192.168.2.1:5434/migconta_db

# Redis Configuration - External Redis Server
REDIS_URL=redis://192.168.2.1:6379/0
CELERY_BROKER_URL=redis://192.168.2.1:6379/0
CELERY_RESULT_BACKEND=redis://192.168.2.1:6379/1

# API Configuration
API_PORT=8000
DEBUG=True
