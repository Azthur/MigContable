# Configuración para Libro 209 Migrator (JSON - Sin dependencias)
# Copiar este archivo a /etc/libro209/config.env o usar como variables de entorno

# SQL Server Configuration (obligatorio) - para datos origen
export SQL_SERVER_HOST=192.168.1.17
export SQL_SERVER_DATABASE=YELAVE22
export SQL_SERVER_USER=sa
export SQL_SERVER_PASSWORD='Pa$$word'

# Empresa Configuration (código de empresa en SQL Server)
export CODCIA=05

# Configuración JSON (ruta al archivo de configuración)
export CONFIG_FILE=/app/MCon/209/libro209_config.json

# NOTA: Toda la configuración (Contasis, cuentas, campos) se carga desde el archivo JSON.
# No hay dependencias de PostgreSQL/MigConta.

# Logging Configuration
export LOG_LEVEL=INFO
export LOG_FILE=/var/log/libro209_migrator.log

# Process Configuration
export BATCH_SIZE=100
export MAX_RETRIES=3
export RETRY_DELAY_SECONDS=60
